# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
# Prebuild output. Anchored paths stopped matching when the app moved to
# apps/app in M1, so these are unanchored now — the native projects are
# regenerated by `expo prebuild` and must never be committed.
ios/
android/
.env.supabase

# Workspace build output
packages/*/dist/
apps/*/dist/

# M0 spike working tree — throwaway by design (the brief: "nothing merges
# to main"). The write-ups in docs/spikes/ are the deliverable; the
# corpus, vendored pdf.js, run artefacts and build logs are not.
spikes/

# Web export output (architecture M4a). Built in CI and locally;
# never committed.
apps/app/dist/
test-results/
playwright-report/
