{
  "compilerOptions": {
    "strict": true,
    "composite": true,
    "declaration": true,
    "noEmit": false,
    "outDir": "dist",
    // Inside outDir on purpose: deleting dist must invalidate the
    // incremental marker, or `tsc -b` no-ops and never recreates it.
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "rootDir": "src",
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
