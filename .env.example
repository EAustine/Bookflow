# Supabase — public-safe keys (anon key is RLS-gated)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key_here

# RevenueCat — public iOS/Android SDK keys (separate per platform; pick one or
# wire both behind a Platform.OS switch in src/lib/revenuecat.ts).
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_or_goog_or_test_key_here

# Google Sign-In OAuth client IDs from Google Cloud Console → APIs & Services
# → Credentials. Web client is required even on native (Expo's expo-auth-session
# uses it as the audience). Android client ties to your APK signing cert
# fingerprint + package name.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
