{
  "expo": {
    "name": "bookflow",
    "slug": "bookflow",
    "scheme": "bookflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eaustine.bookflow",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "associatedDomains": [
        "applinks:getbookflow.co",
        "applinks:www.getbookflow.co"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F2"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.eaustine.bookflow",
      "splash": {
        "image": "./assets/splash-icon-android.png",
        "resizeMode": "contain",
        "backgroundColor": "#FAF7F2"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "getbookflow.co",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "www.getbookflow.co",
              "pathPrefix": "/auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bookflow needs access to your photos so you can set a profile picture."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 10
          },
          "androidIntentFilters": [
            "application/epub+zip",
            "application/pdf"
          ],
          "iosShareExtensionName": "Save to Bookflow"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2D6A4F"
        }
      ],
      "./plugins/withAndroidSplashIcon",
      "expo-router"
    ],
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ca1da768-6ebc-4a2b-adee-de20ce579e2e"
      }
    }
  }
}
