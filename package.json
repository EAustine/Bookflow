{
  "name": "bookflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @bookflow/app",
    "android": "npm run android -w @bookflow/app",
    "ios": "npm run ios -w @bookflow/app",
    "web": "npm run web -w @bookflow/app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "build:tokens": "npm run build -w @bookflow/tokens",
    "tokens:check-figma": "npm run check-figma -w @bookflow/tokens",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > packages/shared/src/database.ts",
    "db:diff": "supabase db diff"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "vitest": "^3.2.4"
  }
}
